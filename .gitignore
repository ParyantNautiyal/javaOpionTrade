# 1. Ignore everything by default
*

# 2. UN-IGNORE the specific things we WANT to track
!src/
!pom.xml
!.gitignore

# 3. Standard ignores for compiled files/folders (just in case)
target/
build/
out/
*.class

# 4. Ignore specific generated/sensitive files/folders explicitly
#    (These might be needed if '!src/' accidentally un-ignored a parent)
*.log
logs/
data/
config/kite_tokens.properties
hs_err_pid*
.idea/
.vscode/
*.iml
# Add any other specific files/directories you want to permanently ignore

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Build tool directories
target/
build/
out/

# Maven
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/

# Gradle
.gradle/
gradle-app.setting
gradle/wrapper/gradle-wrapper.properties

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse
.classpath
.project
.settings/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# VS Code
.vscode/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Application Specific
data/positions/ 