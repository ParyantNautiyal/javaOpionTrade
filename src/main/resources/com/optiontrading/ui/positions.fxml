<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.optiontrading.ui.controller.PositionsController">
   <top>
      <VBox spacing="5">
         <padding>
            <Insets bottom="10" left="15" right="15" top="15" />
         </padding>
         <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="title-label" text="Position Monitor" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh" />
            <ToggleButton fx:id="autoRefreshToggle" text="Auto Refresh" selected="true" />
         </HBox>
         <Label styleClass="subtitle-label" text="Monitor your active positions and their performance" />
      </VBox>
   </top>
   <center>
      <SplitPane dividerPositions="0.75" orientation="VERTICAL">
         <TableView fx:id="positionsTable" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="instrumentCol" text="Instrument" />
               <TableColumn fx:id="strategyCol" text="Strategy" />
               <TableColumn fx:id="quantityCol" text="Qty" />
               <TableColumn fx:id="entryPriceCol" text="Entry Price" />
               <TableColumn fx:id="entryTimeCol" text="Entry Time" />
               <TableColumn fx:id="marketPriceCol" text="Market Price" />
               <TableColumn fx:id="pnlCol" text="P&amp;L" />
               <TableColumn fx:id="pnlPercentCol" text="P&amp;L %" />
               <TableColumn fx:id="statusCol" text="Status" />
               <TableColumn fx:id="targetCol" text="Target" />
               <TableColumn fx:id="stopLossCol" text="Stop Loss" />
               <TableColumn fx:id="actionsCol" text="Actions" />
            </columns>
            <placeholder>
               <Label text="No positions found" />
            </placeholder>
         </TableView>
         <VBox spacing="10">
            <padding>
               <Insets bottom="10" left="15" right="15" top="10" />
            </padding>
            <HBox spacing="10">
               <Label text="Position Details" styleClass="title-label" />
               <Region HBox.hgrow="ALWAYS" />
               <Button fx:id="editPositionButton" text="Edit Position" onAction="#handleEditPosition" disable="true" />
               <Button fx:id="deletePositionButton" text="Delete Position" onAction="#handleDeletePosition" disable="true" />
               <Button fx:id="closePositionButton" text="Close Position" onAction="#handleClosePosition" disable="true" styleClass="action-button" />
            </HBox>
            <GridPane hgap="15" vgap="5">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="200" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="200" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="30" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="30" vgrow="SOMETIMES" />
               </rowConstraints>
               <Label text="Instrument:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
               <Label fx:id="detailInstrument" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1" />
               <Label text="Strategy:" GridPane.rowIndex="0" GridPane.columnIndex="2" />
               <Label fx:id="detailStrategy" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3" />
               
               <Label text="Entry Price:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
               <Label fx:id="detailEntryPrice" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1" />
               <Label text="Current Price:" GridPane.rowIndex="1" GridPane.columnIndex="2" />
               <Label fx:id="detailCurrentPrice" text="-" GridPane.rowIndex="1" GridPane.columnIndex="3" />
               
               <Label text="Stop Loss:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
               <Label fx:id="detailStopLoss" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1" />
               <Label text="Target:" GridPane.rowIndex="2" GridPane.columnIndex="2" />
               <Label fx:id="detailTarget" text="-" GridPane.rowIndex="2" GridPane.columnIndex="3" />
            </GridPane>
            <TitledPane text="Notes" expanded="false">
               <TextArea fx:id="detailNotes" editable="false" prefHeight="80" />
            </TitledPane>
         </VBox>
      </SplitPane>
   </center>
   <bottom>
      <HBox styleClass="status-bar" spacing="15" alignment="CENTER_LEFT">
         <padding>
            <Insets bottom="5" left="15" right="15" top="5" />
         </padding>
         <Label text="Total Positions:" />
         <Label fx:id="totalPositionsLabel" text="0" />
         <Separator orientation="VERTICAL" />
         <Label text="Total P&amp;L:" />
         <Label fx:id="totalPnlLabel" text="₹0.00" />
         <Separator orientation="VERTICAL" />
         <Label fx:id="lastUpdateLabel" text="Last Update: Never" HBox.hgrow="ALWAYS" />
      </HBox>
   </bottom>
</BorderPane> 